# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Set at least one. With ANTHROPIC_API_KEY the app gets real web_search tool
# use and proper citations, which is a visible quality jump. GEMINI_API_KEY
# alone works and is free, but Google Search grounding needs billing enabled
# on the Google Cloud project — without it the app still matches well, it just
# can't read today's live listings.

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Lock the proxy to your own site so it can't be used as a free
# API relay by anyone who finds the URL. Comma-separated, no trailing slash.
# Leave unset to allow any origin (fine for local development only).
ALLOW_ORIGIN=https://your-site.example

# Optional. Requests per IP per minute. Default 40.
RATE_MAX=40
